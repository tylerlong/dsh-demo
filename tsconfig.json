{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": [
		"shared/protocol.ts",
		"src/boot.ts",
		"examples/**/*.ts",
		"src/run-factory.ts",
		"src/real-run-factory.ts",
		"src/server.ts",
		"src/model-list.ts",
		"src/workspace-list.ts",
		"src/harness-adapters.ts",
		"src/serve.ts",
		"test/run-factory.test.ts",
		"test/real-run-factory.test.ts",
		"test/server.test.ts",
		"test/dev-proxy.test.ts",
		"test/model-list.test.ts",
		"test/e2e/app.spec.ts",
		"playwright.config.ts",
		"vitest.config.ts",
		"web/vite.config.ts",
		"web/src/main.tsx",
		"web/src/App.tsx",
		"web/src/api.ts",
		"web/src/ModelSelect.tsx",
		"web/src/WorkspaceSelect.tsx",
		"web/src/RunConfigForm.tsx",
		"web/src/Lane.tsx",
		"web/src/useRun.ts",
		"web/src/test-setup.ts",
		"web/src/ModelSelect.test.tsx",
		"web/src/WorkspaceSelect.test.tsx",
		"web/src/RunConfigForm.test.tsx",
		"web/src/Lane.test.tsx",
		"web/src/useRun.test.tsx",
		"web/src/vite-env.d.ts"
	]
}
