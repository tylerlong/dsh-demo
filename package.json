{
	"name": "harness-workflow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.19.0 || >=24.0.0",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"demo": "tsx --expose-internals examples/index.ts",
		"enhanced": "tsx --expose-internals examples/enhanced-flow.ts",
		"serve": "vite build web && tsx --expose-internals src/serve.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "biome check . --write",
		"format": "biome format . --write"
	},
	"dependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-app-boot": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-cmdline": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-session": "^0.1.0-rc.7",
		"@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.5",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.8"
	}
}
